# ── Vite (build-time) ────────────────────────────────────────────────────────
# Set to "true" on production builds to enable real Google auth.
# Leave unset for local dev — auth is bypassed so you can see the UI.
VITE_AUTH_ENABLED=true

# ── PHP API (server runtime) ─────────────────────────────────────────────────
# Copy this file to .env on the server and fill in the real values.
# .env is gitignored — never commit credentials.

DB_HOST=localhost
DB_NAME=gamepickle
DB_USER=gamepickle_user
DB_PASS=your_db_password_here

GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Get yours free at steamcommunity.com/dev/apikey (requires a Steam account)
STEAM_API_KEY=your_steam_web_api_key

APP_URL=https://gamepickle.perezbox3.com
